<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="beans.xsd">

	<bean class="br.com.poc.occ.dto.user.product.PocProductQuestionWsDTO">
		<property name="question" type="String"/>
	</bean>


    <bean class="br.com.poc.occ.dto.product.PocProductEngagementSummaryWsDTO">
      <import type="com.fasterxml.jackson.annotation.JsonProperty"/>
      <import type="com.fasterxml.jackson.annotation.JsonIgnoreProperties"/>
	  <annotations>@JsonIgnoreProperties(ignoreUnknown = true)</annotations>
          <property name="rating"       type="String"/>
          <property name="distribution" type="java.util.List&lt;br.com.poc.occ.dto.product.PocProductReviewInfoWsDTO&gt;"/>
          <property name="verified"     type="String"/>
          <property name="topReviews" type="java.util.List&lt;br.com.poc.occ.dto.product.PocProductReviewsWsDTO&gt;"/>
          <property name="reviewPublication" type="String"/>
          <property name="questionCount" type="Integer"/>
          <property name="questionPublication" type="String"/>
          <property name="responseTime" type="Integer"/>
    </bean>

    <bean class="br.com.poc.occ.dto.product.PocProductReviewInfoWsDTO">
        <property name="grade" type="Integer"/>
        <property name="gradeCount" type="Integer"/>
    </bean>

    <bean class="br.com.poc.occ.dto.product.PocProductReviewsWsDTO">
        <property name="reviewCount" type="Integer"/>
        <property name="headLine" type="String"/>
    </bean>

	<bean class="br.com.poc.occ.dto.user.product.PocCustomerInquiryWsDTO">
		<property name="customer" type="String"/>
		<property name="product" type="String"/>
		<property name="question" type="String"/>
		<property name="approvalStatus" type="String"/>
	</bean>

</beans>
