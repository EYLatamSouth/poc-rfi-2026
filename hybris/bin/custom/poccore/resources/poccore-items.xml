<items xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="items.xsd">
    <collectiontypes>
        <collectiontype code="CustomerProductInquiryList" elementtype="CustomerProductInquiry" type="set"/>
    </collectiontypes>

    <enumtypes>
        <enumtype code="CustomerInquiryApprovalStatus" dynamic="true">
            <value code="PENDING"/>
            <value code="APPROVED"/>
            <value code="UNAPPROVED"/>
        </enumtype>
    </enumtypes>

    <relations>
        <relation code="CustomerReview2CustomerReviewRating" localized="false">
            <sourceElement type="CustomerReview" qualifier="customerReview" cardinality="one">
                <modifiers read="true" write="true" initial="true" optional="true" search="true"/>
            </sourceElement>
            <targetElement type="CustomerReviewRating" qualifier="customerReviewRating" cardinality="many"
                           ordered="false" collectiontype="set">
                <modifiers read="true" write="true" optional="true" search="true"/>
            </targetElement>
        </relation>
    </relations>

    <itemtypes>
        <typegroup name="Customer">
            <itemtype code="Customer" autocreate="false" generate="false">
                <description>Extending Customer to input custom attributes</description>
                <attributes>
                    <attribute qualifier="customerProductInquiries" type="CustomerProductInquiryList">
                        <persistence type="property"/>
                        <description>Customer Inquiry List</description>
                    </attribute>
                </attributes>
            </itemtype>

            <itemtype code="CustomerReview" autocreate="false" generate="false">
                <description>Extending CustomerReview to input custom attributes</description>
                <attributes>
                    <attribute qualifier="moderationNotes" type="localized:java.lang.String">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <persistence type="property">
                            <columntype>
                                <value>HYBRIS.LONG_STRING</value>
                            </columntype>
                            <columntype database="oracle">
                                <value>varchar2(4000)</value>
                            </columntype>
                            <columntype database="mysql">
                                <value>text</value>
                            </columntype>
                        </persistence>
                    </attribute>
                    <attribute qualifier="hasBoughtProduct" type="java.lang.Boolean">
                        <description>Has the customer bought the product which they wrote a comment?</description>
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <defaultvalue>java.lang.Boolean.FALSE</defaultvalue>
                        <persistence type="property"/>
                    </attribute>
                    <attribute qualifier="helpfulnessRating" type="java.lang.Integer">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="false"/>
                        <persistence type="property"/>
                        <defaultvalue>0</defaultvalue>
                    </attribute>
                </attributes>
            </itemtype>

            <itemtype code="CustomerProductInquiry">
                <deployment table="CustomerProductInquiry" typecode="24246"/>
                <attributes>
                    <attribute qualifier="customer" type="customer">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="false"/>
                        <persistence type="property"/>
                    </attribute>
                    <attribute qualifier="product" type="product">
                        <description>product reference</description>
                        <modifiers unique="false" read="true" search="true" initial="true" optional="false"/>
                        <persistence type="property"/>
                    </attribute>
                    <attribute qualifier="question" type="localized:java.lang.String">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="false"/>
                        <persistence type="property">
                            <columntype>
                                <value>HYBRIS.LONG_STRING</value>
                            </columntype>
                            <columntype database="oracle">
                                <value>varchar2(4000)</value>
                            </columntype>
                            <columntype database="mysql">
                                <value>text</value>
                            </columntype>
                        </persistence>
                    </attribute>
                    <attribute qualifier="answer" type="localized:java.lang.String">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <persistence type="property">
                            <columntype>
                                <value>HYBRIS.LONG_STRING</value>
                            </columntype>
                            <columntype database="oracle">
                                <value>varchar2(4000)</value>
                            </columntype>
                            <columntype database="mysql">
                                <value>text</value>
                            </columntype>
                        </persistence>
                    </attribute>
                    <attribute qualifier="approvalStatus" type="customerInquiryApprovalStatus">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <defaultvalue>em().getEnumerationValue("CustomerInquiryApprovalStatus","PENDING")</defaultvalue>
                        <persistence type="property"/>
                    </attribute>
                    <attribute qualifier="answerDate" type="java.util.Date">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <persistence type="property"/>
                    </attribute>
                </attributes>
            </itemtype>

            <itemtype code="CustomerReviewRating">
                <deployment table="CustomerReviewRating" typecode="24247"/>
                <attributes>
                    <attribute qualifier="customer" type="customer">
                        <modifiers unique="false" read="true" search="true" initial="true" optional="true"/>
                        <persistence type="property"/>
                    </attribute>
                    <attribute qualifier="isUseful" type="java.lang.Boolean">
                        <description>This attribute can be set to true to indicate that the review is useful.</description>
                        <modifiers unique="false" read="true" search="true" initial="true" optional="false"/>
                        <defaultvalue>java.lang.Boolean.FALSE</defaultvalue>
                        <persistence type="property"/>
                    </attribute>
                </attributes>
            </itemtype>
        </typegroup>
    </itemtypes>

</items>
